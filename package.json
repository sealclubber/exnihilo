{
  "name": "worldsim",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:viewer": "vitest run --config vitest.viewer.config.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/client && tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm test",
    "import": "node packages/server/src/cli.ts",
    "server": "node packages/server/src/main.ts",
    "client": "npm run dev -w @worldsim/client",
    "client:build": "npm run build -w @worldsim/client",
    "generate": "node packages/server/src/generate-cli.ts",
    "day": "node packages/server/src/day-cli.ts",
    "render": "node packages/server/src/render-cli.ts"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  }
}
